#!/usr/bin/env rc
flag e +
~ $#* 2 || {
  echo 'Usage: graph.rc TRANSFORM GNUPLOT_TERM'
  exit 1
}
{
  echo '
    set term '$2'
    set title "CZEngine transform '$1'"
    set multiplot
  '
  for (m in 0.5 0.25 0.1 0.05) {
    ./table $1 $m > cz$m.dat
    echo '
      plot "cz'$m'.dat" using 1:2 title '''dist. phase''' with lines, "cz'$m'.dat" using 1:3 title '''final''' with lines
    '
  }
} | gnuplot
